# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/

# ── Model weights (large binary files — downloaded during docker build) ───────
models/
*.gguf
*.bin
*.safetensors
*.onnx
*.pt
*.pth

# ── Spec & participant docs (not needed at runtime) ───────────────────────────
spec/
*.pdf

# ── Skill configs (CI/agent tooling only) ────────────────────────────────────
.agents/
skills-lock.json

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.local

# ── Data artifacts (keep structure, ignore generated) ─────────────────────────
data/metrics/*.jsonl

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── OTHERS ────────────────────────────────────────────────────────────────────────
tasks.json
results.json
*.log
